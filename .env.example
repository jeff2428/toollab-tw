THREADS_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Telegram Bot (可同時用於公開頻道自動推播 + 異常告警)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHAT_ID=

# === 每週自動電子報派發 (選填，未填仍會產出公開存檔頁 newsletter/latest.html) ===
BUTTONDOWN_API_KEY=
BREVO_API_KEY=

# === 異常告警 Webhook (選填；未填時仍會自動透過 GitHub Issue 寄信通知) ===
DISCORD_WEBHOOK_URL=

# === 搜尋引擎即時通知 & 流量轉換追蹤 (選填) ===
INDEXNOW_KEY=
GA4_MEASUREMENT_ID=
CF_ANALYTICS_TOKEN=
