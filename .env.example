# === 核心 AI 生成引擎 ===
GEMINI_API_KEY=

# === 網站部署與網址設定 ===
SITE_URL=https://toollab-tw.pages.dev
SITE_BASE_PATH=

# === 社群官方 API 自動分發 ===
# 支援多站專屬前綴：例如 SAASRADAR_EN_THREADS_USER_ID / TRIPDEALS_TW_THREADS_USER_ID
# 若未設定站點專屬前綴，則自動共用下方全域金鑰
